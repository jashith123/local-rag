# Copy to .env and edit. .env is gitignored; this file is not.
# Everything works with no .env at all — these are the knobs, with defaults.

# --- Answer generation ----------------------------------------------------
# "ollama"    local model: free, offline, no key   (default)
# "anthropic" Claude API: needs a key, costs money
CHAT_PROVIDER=ollama

# Ollama. Must be a model you've pulled — check with `ollama list`.
# qwen3:4b-instruct  default. ~3.7s/answer, cites well, refuses cleanly
# qwen2.5:3b         similar speed, but cites a passage even when refusing
# llama3.2:3b        fast, more verbose
# qwen3:4b / :8b     AVOID for this — they always think first (6-20x slower)
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192

# Only needed when CHAT_PROVIDER=anthropic.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Vector database ------------------------------------------------------
# Unset, Qdrant runs embedded under backend/storage/qdrant — no Docker needed.
# Set this to use the container in docker/docker-compose.yml, then re-index:
#   python scripts/reindex.py
# QDRANT_URL=http://localhost:6333
